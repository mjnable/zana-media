{
    "name": "mj-zana/media",
    "description": "Responsive images for Zana applications: WebP and AVIF variants, metadata stripped, alt text per locale",
    "type": "library",
    "keywords": ["zana", "media", "images", "webp", "avif", "responsive"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-gd": "*",
        "mj-zana/core": "^2.2",
        "mj-zana/filesystem": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-exif": "To apply the orientation phones record in JPEG photos"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Media\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.2.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.2.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.2.0" } } },
        { "type": "path", "url": "../zana-filesystem", "options": { "symlink": true, "versions": { "mj-zana/filesystem": "2.2.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
